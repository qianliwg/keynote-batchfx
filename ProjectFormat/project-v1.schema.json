{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kmotion:project:1",
  "title": "Keynote 动效工坊 project v1",
  "type": "object",
  "required": [
    "formatVersion",
    "projectID",
    "source",
    "canvas",
    "segments",
    "target",
    "orientation",
    "spans",
    "drawLine",
    "playback",
    "fps"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "projectID": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "slideID": {
      "type": [
        "string",
        "null"
      ]
    },
    "routeObjectID": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetObjectID": {
      "type": [
        "string",
        "null"
      ]
    },
    "canvas": {
      "$ref": "#/$defs/vec"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cubic"
      }
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "size",
        "anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/positiveVec"
        },
        "anchor": {
          "$ref": "#/$defs/unitVec"
        },
        "rotationDegrees": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "orientation": {
      "enum": [
        "fixed",
        "route-tangent"
      ]
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "drawLine": {
      "type": "boolean"
    },
    "playback": {
      "enum": [
        "once",
        "loop",
        "ping-pong"
      ]
    },
    "fps": {
      "enum": [
        30,
        60
      ]
    },
    "effects": {
      "$ref": "#/$defs/effects"
    }
  },
  "$defs": {
    "vec": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "positiveVec": {
      "allOf": [
        {
          "$ref": "#/$defs/vec"
        }
      ],
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "unitVec": {
      "allOf": [
        {
          "$ref": "#/$defs/vec"
        }
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "cubic": {
      "type": "object",
      "required": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "additionalProperties": false,
      "properties": {
        "p0": {
          "$ref": "#/$defs/vec"
        },
        "p1": {
          "$ref": "#/$defs/vec"
        },
        "p2": {
          "$ref": "#/$defs/vec"
        },
        "p3": {
          "$ref": "#/$defs/vec"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "relativePath",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "duration",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "from": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera": { "$ref": "#/$defs/camera" },
        "parallax": { "type": "array", "items": { "$ref": "#/$defs/parallax" }, "maxItems": 64 },
        "textCues": { "type": "array", "items": { "$ref": "#/$defs/textCue" }, "maxItems": 128 },
        "arrayWave": { "$ref": "#/$defs/arrayWave" },
        "audioBeats": { "$ref": "#/$defs/audioBeats" },
        "loopCount": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "startCenter": { "$ref": "#/$defs/vec" },
        "endCenter": { "$ref": "#/$defs/vec" },
        "startZoom": { "type": "number", "exclusiveMinimum": 0 },
        "endZoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "parallax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "depth": { "type": "number", "minimum": -4, "maximum": 4 },
        "size": { "$ref": "#/$defs/positiveVec" },
        "offset": { "$ref": "#/$defs/vec" }
      }
    },
    "textCue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "$ref": "#/$defs/vec" },
        "startOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "endOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "startScale": { "type": "number", "exclusiveMinimum": 0 },
        "endScale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "arrayWave": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "spacing": { "type": "number" },
        "amplitude": { "type": "number" },
        "frequency": { "type": "number" },
        "phase": { "type": "number" }
      }
    },
    "audioBeats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "audioPath": { "type": ["string", "null"] },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "offset": { "type": "number" },
        "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    }
  }
}
